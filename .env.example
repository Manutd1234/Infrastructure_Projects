# Copy to .env and adjust. The .env file is gitignored.
# All vars use the NUSSIF_ prefix (backend/app/core/config.py).
#
# No API keys required.
# CryptoCycle uses yfinance (public Yahoo Finance).
# HedgeFund13F scrapes Dataroma HTML (no key).
# CongressTrades scrapes Capitol Trades HTML (no key).
# Do not add Alpha Vantage / Polygon / FRED / OpenAI keys unless you
# later replace a source. The current stack is fully keyless.

# ---- Database ----
NUSSIF_DATABASE_URL=sqlite:///database/nussif.db

# ---- Modules ----
# Leave unset. The three modules live at the repo root.
# NUSSIF_PIPELINES_DIR=.

# ---- Ops ----
# Leave false unless the dashboard should trigger pipeline runs.
NUSSIF_ENABLE_RUN_ENDPOINT=false
NUSSIF_RUN_TIMEOUT_SECONDS=600

# ---- CORS ----
NUSSIF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Logging ----
NUSSIF_LOG_LEVEL=INFO
