# NUSSIF Infrastructure Projects — environment template.
# Copy to .env and adjust. The .env file is gitignored.
# All vars use the NUSSIF_ prefix and are read by backend/app/core/config.py.

# ---- Database ----
# SQLite file path. Default points to database/nussif.db.
NUSSIF_DATABASE_URL=sqlite:///database/nussif.db

# ---- Pipelines ----
# Where the pipeline code lives (used by the /ops/run/* endpoints).
NUSSIF_PIPELINES_DIR=data/pipelines

# ---- Ops ----
# Gate the /ops/run/{pipeline} endpoints. Leave false unless you want the
# dashboard to be able to trigger pipeline runs.
NUSSIF_ENABLE_RUN_ENDPOINT=false
# Subprocess timeout for a triggered run, in seconds.
NUSSIF_RUN_TIMEOUT_SECONDS=600

# ---- CORS ----
# Comma-separated list of allowed origins for the API.
NUSSIF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Logging ----
NUSSIF_LOG_LEVEL=INFO

# ---- Scraping (pipelines) ----
# Optional: override the default User-Agent for Dataroma / Capitol Trades.
NUSSIF_SCRAPER_USER_AGENT=Mozilla/5.0 (NUSSIF research; contact: ops@nussif.example)
# Polite sleep between requests, in seconds.
NUSSIF_SCRAPER_SLEEP=0.5

# ---- yfinance (pipelines) ----
# Optional: yfinance proxy. Leave blank for none.
NUSSIF_YF_PROXY=
